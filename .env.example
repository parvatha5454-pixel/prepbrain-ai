# Copy to .env (never commit .env)
DATABASE_URL="file:./dev.db"          # SQLite for local dev. Use a Postgres URL in production.
AUTH_SECRET=""                         # REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GEMINI_API_KEY=""                      # Optional. Without it the app uses deterministic offline fallbacks.
GEMINI_MODEL="gemini-3.6-flash"        # Optional override
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"   # Optional backup if the main model is busy
